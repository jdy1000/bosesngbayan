# Boses ng Bayan — environment variables. Copy to .env.local and fill in.
# NEVER commit real values. Only NEXT_PUBLIC_* values are sent to browsers.

# --- Public (browser-safe) -------------------------------------------------
# Supabase project URL and anon/publishable key (Project Settings → API).
# Local stack: printed by `pnpm db:start` (http://127.0.0.1:54321).
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Canonical site origin, used for metadata, sitemaps, RSS, invitations and CSRF origin checks.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Server-only secrets -----------------------------------------------------
# Supabase service-role key. Server-side only: votes, subscriptions, submissions, page views,
# scheduler, invitations. Never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
# 32+ random characters. HMAC key for hashed voter/visitor/network identifiers.
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
HASH_SECRET=
# 32+ random characters. Bearer token for /api/cron/* (scheduled publishing, retention).
CRON_SECRET=

# --- Optional: email provider (newsletter campaigns are NOT sent unless configured) ---
# Supabase Auth sends staff invitation/recovery emails through its own SMTP settings.
# RESEND_API_KEY=
